# Get these from sanity.io/manage after creating a free project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-01

# Used only for future webhook/revalidation endpoints; do not expose this value
SANITY_REVALIDATE_SECRET=

# Cloudinary direct upload inside the embedded Sanity Studio. Use a tightly
# restricted unsigned upload preset; this name is intentionally public.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
